{
  "search_directories": [
    "test_data/disk_index_search"
  ],
  "jobs": [
    {
      "type": "graph-index-build-spherical-quantization",
      "content": {
        "build": {
          "data_type": "float32",
          "data": "disk_index_siftsmall_learn_256pts_data.fbin",
          "distance": "squared_l2",
          "start_point_strategy": "medoid",
          "max_degree": 32,
          "l_build": 50,
          "alpha": 1.2,
          "backedge_ratio": 1.0,
          "num_threads": 1,
          "multi_insert": null
        },
        "search_phase": {
          "search-type": "topk",
          "queries": "disk_index_sample_query_10pts.fbin",
          "groundtruth": "disk_index_10pts_idx_uint32_exact_ground_truth.bin",
          "reps": 20,
          "num_threads": [
            1
          ],
          "runs": [
            {
              "search_n": 10,
              "search_l": [
                20
              ],
              "recall_k": 10
            }
          ]
        },
        "seed": 12648430,
        "transform_kind": {
          "padding_hadamard": "natural"
        },
        "query_layouts": [
          "full_precision"
        ],
        "num_bits": 1,
        "pre_scale": {
          "some": 0.00390625
        }
      }
    }
  ]
}

