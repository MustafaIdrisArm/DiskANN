            "queries": "3000pts_256dim_int8_query.fbin",
            "groundtruth": "300000pts_256dim_int8_gt.bin",
            "reps": 5,
            "num_threads": [1, 2, 8, 12, 16],
            "runs": [
              {
                "search_n": 10,
                "search_l": [20, 40, 80, 100, 150, 200, 250],
                "recall_k": 10
              }
            ]
          }
        }
      }
    ]
